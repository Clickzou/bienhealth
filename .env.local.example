# ============================================================
#  Variables d'environnement — site bien.health (headless)
#  Copier ce fichier en .env.local et remplir les valeurs.
#  .env.local n'est JAMAIS versionne (voir .gitignore).
# ============================================================

# --- Shopify Storefront API (lecture produits + panier) ---
SHOPIFY_STORE_DOMAIN=b3a79e-89.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-04

# --- Supabase (contenu : blog, FAQ, quiz, pages, leads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://bien.health

# --- Trustpilot (widget officiel TrustBox, avis en temps reel) ---
# A recuperer dans Trustpilot Business > Showcase (Vitrine) > TrustBox :
#   - BUSINESSUNIT_ID : identifiant de l'etablissement (ex: 5f... sur 24 caracteres)
#   - TEMPLATE_ID     : identifiant du modele de widget choisi (carousel, mini, etc.)
NEXT_PUBLIC_TRUSTPILOT_BUSINESSUNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_TEMPLATE_ID=
