# ============================================================
#  Variables d'environnement — site bien.health (headless)
#  Copier ce fichier en .env.local et remplir les valeurs.
#  .env.local n'est JAMAIS versionne (voir .gitignore).
# ============================================================

# --- Shopify Storefront API (lecture produits + panier) ---
SHOPIFY_STORE_DOMAIN=b3a79e-89.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-04

# Domaine du CHECKOUT Shopify (cote client). OBLIGATOIRE en production :
# sans lui, le bouton "Passer au paiement" pointe vers NEXT_PUBLIC_SITE_URL,
# c'est-a-dire le site headless lui-meme, et le tunnel de vente est casse.
NEXT_PUBLIC_SHOPIFY_DOMAIN=b3a79e-89.myshopify.com

# --- Supabase (contenu : blog, FAQ, quiz, pages, leads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://bien.health

# Indexation par les moteurs de recherche. Le site se met automatiquement en
# noindex hors production et tant qu'il tourne sur un domaine *.vercel.app.
# Mettre "false" pour forcer le noindex (preprod sur domaine custom, recette...).
# NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Pixel Meta (Facebook / Instagram) ---
# ID du pixel (15-16 chiffres), a recuperer dans Meta Events Manager >
# Sources de donnees > (le pixel) > Parametres > ID du pixel.
# Si vide, repli sur l'ID public du site en PRODUCTION uniquement
# (constante META_PIXEL_FALLBACK dans src/lib/meta-pixel.ts).
# Le pixel n'est charge qu'apres acceptation des cookies (banniere RGPD).
# Laisser vide desactive completement le pixel (utile en local).
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Analytics 4 (mesure d'audience, conforme RGPD) ---
# ID de mesure (format G-XXXXXXXXXX), a recuperer dans GA > Admin >
# Flux de donnees > (flux Web) > ID de mesure.
# Optionnel : en PRODUCTION, l'ID public est deja repli par defaut dans le code
# (composant google-analytics.tsx). Laisser vide en local evite de tracker le dev.
NEXT_PUBLIC_GA_ID=

# --- Avis clients ---
# Rien a configurer : les avis viennent de Loox, qui recopie note et volume
# dans les metafields Shopify standard (reviews.rating / reviews.rating_count),
# lus avec le meme token Storefront que le catalogue.

# ============================================================
#  Tableau de bord "SEO by Clickzou" (/seo) - outil interne
# ============================================================

# --- Acces au tableau de bord ---
# Identifiants de connexion. Optionnels : le compte livre est deja inscrit dans
# le code (login en clair, mot de passe sous forme d'empreinte scrypt, cf.
# src/lib/seo-dashboard/auth.ts). Renseigner ces variables pour changer de
# compte sans toucher au code ni redeployer.
SEO_DASHBOARD_USER=
SEO_DASHBOARD_PASSWORD=
# Cle de signature des sessions. Par defaut derivee du mot de passe : changer le
# mot de passe deconnecte donc tout le monde, ce qui est le comportement voulu.
SEO_DASHBOARD_SECRET=

# --- Lecture Google Analytics 4 + Search Console ---
# Compte de service Google (console.cloud.google.com > IAM > Comptes de
# service), avec les API "Google Analytics Data" et "Google Search Console"
# activees. Coller ici le JSON de la cle, encode en base64 (une seule ligne) :
#   certutil -encode cle.json cle.b64   (Windows)
#   base64 -w0 cle.json                 (Linux/macOS)
# L'adresse ...@....iam.gserviceaccount.com doit ensuite etre ajoutee :
#   - dans GA4 : Admin > Gestion des acces a la propriete, role Lecteur
#   - dans Search Console : Parametres > Utilisateurs, autorisation Complete
GOOGLE_SERVICE_ACCOUNT_JSON=
# Identifiant NUMERIQUE de la propriete GA4 (Admin > Details de la propriete).
# Ce n'est pas le G-XXXXXXXXXX, qui identifie le flux de donnees.
GA4_PROPERTY_ID=
# Propriete Search Console interrogee. Par defaut sc-domain:<domaine du site>.
# A renseigner seulement si la propriete validee est un prefixe d'URL.
GSC_SITE_URL=
